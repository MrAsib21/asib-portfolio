# Resend API Key for sending contact form emails
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL=asib@example.com

# Site URL for metadata & canonical links
NEXT_PUBLIC_SITE_URL=https://asibmahmud.com

# Strict Content Validation (set to true in CI/production builds to fail on placeholder tokens)
STRICT_CONTENT=false

# Optional Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=asibmahmud.com

